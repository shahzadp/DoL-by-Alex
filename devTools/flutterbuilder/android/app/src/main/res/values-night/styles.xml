<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Dark-mode variant. Identical to values/styles.xml on purpose: a mismatch
      here would show as a flash on dark-mode devices only.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/dol_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_dol_mark</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/dol_splash_background</item>
    </style>
</resources>