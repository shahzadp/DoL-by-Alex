<?xml version="1.0" encoding="utf-8"?>
<!--
  Launch splash, used as the window background on Android 11 and below. The
  Android 12+ SplashScreen API draws the same mark from ic_dol_mark via
  windowSplashScreenAnimatedIcon, so both paths show the same thing.

  One vector rather than density-bucketed splash.png files, so it is sharp at
  every density. android:width/height on a layer-list item needs API 23, and
  minSdk is 24.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/dol_splash_background" />
    <item
        android:drawable="@drawable/ic_dol_mark"
        android:gravity="center"
        android:width="168dp"
        android:height="168dp" />
</layer-list>