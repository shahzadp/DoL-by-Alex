<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon. Layers are density-specific PNGs generated from
  assets/app-icon.png (foreground: full-bleed artwork; background: the artwork's
  own backdrop, #476069; monochrome: white silhouette for Android 13+ themed
  icons). Legacy densities use the mipmap-*/ic_launcher*.png files, the round
  variant is circle-masked. Splash is a separate surface, see values/colors.xml.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>