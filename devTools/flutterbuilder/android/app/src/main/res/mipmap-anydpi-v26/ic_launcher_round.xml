<?xml version="1.0" encoding="utf-8"?>
<!--
  Round launcher icon. Deliberately identical to ic_launcher.xml: adaptive icons
  are masked by the launcher, so a round variant only needs to exist for API 26+
  and there is nothing round-specific about the artwork.

  It used to reference @mipmap/ic_launcher_foreground, which does not exist.
  The foreground vector lives at @drawable/ic_launcher_foreground. AAPT rejects
  the mipmap form with "resource mipmap/ic_launcher_foreground not found" and
  the build fails. The same typo was in the Capacitor builder's copy of this
  file.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>