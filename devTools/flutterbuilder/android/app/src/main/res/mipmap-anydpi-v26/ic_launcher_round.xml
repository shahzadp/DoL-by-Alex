<?xml version="1.0" encoding="utf-8"?>
<!--
  Round launcher icon. Deliberately identical to ic_launcher.xml: adaptive icons
  are masked by the launcher, so a round variant only needs to exist for API 26+
  and there is nothing round-specific about the artwork.

  Foreground and monochrome layers are density-specific PNGs at
  @drawable/ic_launcher_foreground / @drawable/ic_launcher_monochrome, generated
  from assets/app-icon.png.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>