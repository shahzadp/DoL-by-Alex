<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Two backdrops, deliberately not the same colour.

      The launcher icon backdrop is #476069, sampled from the edges of
      assets/app-icon.png (the artwork's own backdrop), so the adaptive icon's
      background layer matches the foreground artwork instead of fighting it.
      The splash is #111111 because it is a full-screen surface that sits in
      front of the game for the whole of its load: a lighter splash would
      flash before the dark game UI.

      Sharing one colour between them meant that fixing the icon silently
      recoloured the splash. See MEMORY.md trap 2.
    -->
    <color name="ic_launcher_background">#476069</color>
    <color name="dol_splash_background">#111111</color>
</resources>