<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Two backdrops, deliberately not the same colour.

      The launcher icon is white because that is what the source SVG
      (assets/icon-only.svg) was drawn on. The splash is #111111 because it is a
      full-screen surface that sits in front of the game for the whole of its
      load: a white splash would flash hard before the dark game UI.

      Sharing one colour between them meant that fixing the icon silently
      recoloured the splash. See MEMORY.md trap 2.
    -->
    <color name="ic_launcher_background">#FFFFFF</color>
    <color name="dol_splash_background">#111111</color>
</resources>