# Generated by package manager
node_modules/

# The android SDK is a per-machine install, see README-windows.txt
/androidsdk/

# leftovers from the Cordova build, safe to delete
/platforms/
/plugins/
/tmp/

# assembled from the compiled game by scripts/prepare_capacitor_files.js
/capwww/

# The android/ project is source and should be committed; its build output is not.
/android/app/build/
/android/build/
/android/.gradle/
/android/app/src/main/assets/public/
/android/app/src/main/assets/capacitor.config.json
/android/app/release/
/android/local.properties

# build.json holds the keystore password; never commit it
build.json

package-lock.json