{
  "name": "apk-builder",
  "displayName": "built app",
  "version": "1.0.0",
  "description": "pack the DoL html game into an android app with Capacitor",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "verify:origin": "node scripts/verify_storage_origin.js",
    "cap:prepare": "node scripts/prepare_capacitor_files.js",
    "cap:sync": "npm run cap:prepare && cap sync android",
    "apk:debug": "npm run cap:sync && node scripts/build_app_capacitor.js",
    "apk:release": "npm run cap:sync && set BUILD_RELEASE=true&& node scripts/build_app_capacitor.js"
  },
  "keywords": [
    "capacitor",
    "android"
  ],
  "author": "majou",
  "license": "you owe author a beer now.",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/toast": "^8.0.1"
  }
}
