{
  "appId": "com.vrelnir.dol",
  "appName": "Degrees of Lewdity",
  "webDir": "capwww",
  "loggingBehavior": "none",

  "server": {
    "hostname": "localhost",
    "androidScheme": "https"
  },

  "android": {
    "buildOptions": {
      "releaseType": "APK"
    },
    "minWebViewVersion": 60
  },

  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "backgroundColor": "#111111",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DEFAULT"
    }
  }
}