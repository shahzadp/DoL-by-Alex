
# Ensure that the android contents are checked out as lf
devTools/androidsdk/image text eol=lf

# enforce proper line endings on commit
*.sh	text eol=lf
*.js	text eol=lf
*.cjs	text eol=lf
*.ts	text eol=lf
*.css	text eol=lf
*.twee	text eol=lf
*.py	text eol=lf
*.txt	text eol=lf
*.bat	text eol=lf

# gradlew is an extensionless POSIX shell script. core.autocrlf would check it
# out with CRLF on Windows, which breaks it with "bad interpreter: /bin/sh^M"
# when the tree is built on Linux or macOS.
gradlew	text eol=lf
**/gradlew	text eol=lf
