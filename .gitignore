# A gitignore file specifies intentionally untracked files that Git
# should ignore. Files already tracked by Git are not affected!!
## The `git add` command can be used to add ignored files with the
## -f (force) option.
## Consult `git help gitignore` and `git help add` for more info.

# Keys to sign the generated .apks. You don't want them leaked.
/keys/*
# Generated apks themselves.
/dist/*
# Compiled game htmls.
Degrees of Lewdity*.html
# Personal userscripts.
usettings.js

# Archives
*.7z
*.zip
*.rar
*.tar
*.gz
*.xz

# Node directories and dependencies
node_modules/

# Operating System files
Desktop.ini
Thumbs.db

# Hidden, temporary, and logging files
.*
*~
*.tmp
*.log

# Miscellaneous formats
*.iml

# Ignoring working folder for Quin2k
mod/
*.code-workspace
release/

# Save files
*.save

# Flutter android builder.
#
# Its own devTools/flutterbuilder/.gitignore is shadowed by the `.*` rule above,
# so the rules that actually matter live here, in a tracked file. Without this,
# a fresh clone would happily commit ~63 MB of generated assets and would have
# no ignore rule at all for the release keystore.
/devTools/flutterbuilder/assets/web/
/devTools/flutterbuilder/build/
/devTools/flutterbuilder/.dart_tool/
/devTools/flutterbuilder/android/build/
/devTools/flutterbuilder/android/local.properties
/devTools/flutterbuilder/android/key.properties
/devTools/flutterbuilder/android/*.jks
/devTools/flutterbuilder/android/*.keystore

# The loading-screen QA harness. It is real tooling, and both builder READMEs
# point at .preview/build-preview.js, so it has to defeat the `.*` rule above --
# otherwise the documentation references a file that is not in the repository.
# This is a negation, not an ignore: git must descend into the directory for the
# rule to have any effect.
!/devTools/flutterbuilder/.preview/

# The Android SDK. Per-machine, multi-gigabyte, and originally installed for the
# Capacitor builder at devTools/apkbuilder/androidsdk with the ignore rule living
# in that tree's own .gitignore. Deleting the tree deleted the rule with it, so
# it is restated here: a fresh clone must never be able to commit this.
/devTools/androidsdk/

# Gitlab configuration
!.gitlab
